# Copy these settings into backend/.env. Changes require a backend restart.
# off: no inference; review: suggestions only; apply: update unoverridden flags.
LAYA_MODE=off
LAYA_MODEL=convaiinnovations/laya-multilingual
LAYA_MODEL_REVISION=e4e9ddf21a7b1903b7acffd8814ad4307bf63a67
# Required for apply mode: choose from held-out labeled prompts, not a guessed cutoff.
LAYA_LABEL_THRESHOLD=
# Optional absolute path on persistent storage; default is backend/data/labels.sqlite3.
# LABEL_DB_PATH=C:/path/to/persistent/labels.sqlite3
